# Optional. `docker compose up` works without a .env file: these are the
# defaults it already uses. Copy this file to .env only to change one.

# SQLAlchemy database URL. The default keeps the SQLite file on the issue-data volume.
DATABASE_URL=sqlite:////data/issues.db

# Load 44 demo issues at startup, only if the database is empty (true or false).
SEED_ON_STARTUP=true

# IANA timezone used to display dates. Data is always stored in UTC.
APP_TIMEZONE=Europe/Rome
